{
  "name": "locale-keysmith",
  "version": "0.3.0",
  "description": "CLI helper for sorting, auditing, cleaning, and translating i18n locale keys.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "bin": {
    "locale-keysmith": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --mode live test/translate.live.test.ts",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test",
    "prepublishOnly": "pnpm run check"
  },
  "keywords": [
    "i18n",
    "l10n",
    "locale",
    "translation",
    "cli"
  ],
  "author": "Faysal Ahmed Akash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faysalakash/locale-keysmith.git"
  },
  "homepage": "https://github.com/faysalakash/locale-keysmith#readme",
  "bugs": {
    "url": "https://github.com/faysalakash/locale-keysmith/issues"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
