{
  "name": "lingo-keysmith",
  "version": "0.1.0",
  "description": "CLI helper for sorting, auditing, cleaning, and translating i18n locale keys.",
  "type": "module",
  "packageManager": "pnpm@10.4.0",
  "bin": {
    "lingo-keysmith": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run test",
    "prepublishOnly": "pnpm run check"
  },
  "keywords": [
    "i18n",
    "l10n",
    "locale",
    "translation",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
